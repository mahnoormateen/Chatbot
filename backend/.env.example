#--------------------------------------------------------------------
# Node
#--------------------------------------------------------------------
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

#--------------------------------------------------------------------
# App
#--------------------------------------------------------------------
# Generate a new key with: node ace generate:key
APP_KEY=
APP_URL=http://${HOST}:${PORT}

#--------------------------------------------------------------------
# Postgres
#--------------------------------------------------------------------
# This machine runs PostgreSQL 18 on port 5433 (not the default 5432).
DB_HOST=localhost
DB_PORT=5433
DB_USER=gemini_chatbot
DB_PASSWORD=change_me
DB_DATABASE=gemini_chatbot

#--------------------------------------------------------------------
# Gemini
#--------------------------------------------------------------------
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Preferred model when a request does not specify one.
# This is only a preference, not a requirement. The backend reads the
# live model list for this key and confirms each entry with a real
# request, so a name that is retired or over quota here falls through to
# a model that actually answers instead of breaking every turn.
GEMINI_MODEL=gemini-flash-latest

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
# Comma separated list of allowed origins. Leave empty to allow any
# origin in development and none in production.
# Comma separated list of allowed origins. Leave empty to allow any
# origin in development and none in production.
# 3001 is listed as well because Nuxt moves to the next free port when
# 3000 is busy, and a silent port shift would otherwise break every call.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
